# ============================================================
# TrustChain Supply — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://trustchain:trustchain_pass@postgres:5432/trustchain_db
DATABASE_URL_SYNC=postgresql://trustchain:trustchain_pass@postgres:5432/trustchain_db
POSTGRES_USER=trustchain
POSTGRES_PASSWORD=trustchain_pass
POSTGRES_DB=trustchain_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_SECRET_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Blockchain (Hardhat local by default) ---
BLOCKCHAIN_RPC_URL=http://blockchain-node:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CHAIN_ID=31337

# Contract addresses (populated after deployment)
CONTRACT_SUPPLY_CHAIN_REGISTRY=
CONTRACT_BATCH_REGISTRY=
CONTRACT_PACKAGE_IDENTITY=
CONTRACT_SHIPMENT_CONTRACT=
CONTRACT_ATTESTATION_REGISTRY=
CONTRACT_FRAUD_REGISTRY=

# --- IPFS / Pinata ---
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# --- IoT Simulator ---
IOT_SIMULATOR_URL=http://iot-simulator:8001
IOT_SIGNING_KEY=CHANGE_ME_IOT_MASTER_SIGNING_KEY

# --- Oracle Service ---
ORACLE_SERVICE_URL=http://oracle-service:8002

# --- Application ---
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=31337

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
